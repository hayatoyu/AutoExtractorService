{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ExtractorSettings": {
    "WatchFolder": "C:\\Users\\j4m0w\\Downloads\\test\\autoextractor",
    "SevenZipPath": "C:\\Program Files\\7-Zip\\7z.exe",
    "SevenZipTimeout": 600000,
    "Password": [ "", "9527" ],
    "VideoExtensions": [ ".mp4", ".mkv", ".avi", ".wmv", ".mov", ".flv", ".m4v", ".ts" ],
    "SubtitleExtensions": [ ".srt", ".ass", ".ssa", ".vtt", ".sub", ".idx" ],
    "ArchiveExtensions": [ ".zip", ".7z", ".rar", ".tar", ".gz" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
